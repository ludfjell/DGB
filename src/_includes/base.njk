{% set t = p.t %}
<!doctype html>
<html lang="{{ p.htmlLang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ t.meta.title }}</title>
  <meta name="description" content="{{ t.meta.description }}">
  {% if not site.launched %}
  <meta name="robots" content="noindex">
  {% endif %}
  <link rel="canonical" href="{{ p.url }}">
  {% for alternate in p.alternates %}
  <link rel="alternate" hreflang="{{ alternate.hreflang }}" href="{{ alternate.url }}">
  {% endfor %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ t.meta.title }}">
  <meta property="og:description" content="{{ t.meta.description }}">
  <meta property="og:url" content="{{ p.url }}">
  <meta property="og:locale" content="{{ p.ogLocale }}">
  {% for locale in p.ogLocaleAlternates %}
  <meta property="og:locale:alternate" content="{{ locale }}">
  {% endfor %}
  <meta property="og:image" content="{{ p.og.url }}">
  <meta property="og:image:width" content="{{ p.og.width }}">
  <meta property="og:image:height" content="{{ p.og.height }}">
  <meta property="og:image:alt" content="{{ p.og.alt }}">
  <meta name="twitter:card" content="summary_large_image">
  {% if site.googleSiteVerification %}
  <meta name="google-site-verification" content="{{ site.googleSiteVerification }}">
  {% endif %}
  <link rel="icon" type="image/png" href="{{ site.assets.favicon }}">
  <link rel="stylesheet" href="{{ site.assets.css }}">
  <script src="{{ site.assets.js }}" defer></script>
  <script type="application/ld+json">
{{ p.jsonld | safe }}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">{{ t.nav.skipLink }}</a>

  <header class="site-header">
    <h1 class="site-name">{{ site.name }}</h1>
    <nav class="site-nav" aria-label="{{ t.nav.label }}">
      <ul>
        {% for key in ["menu", "history", "takeaway", "faq", "contact"] %}
        <li><a href="#{{ t.sections[key].slug }}">{{ t.sections[key].nav }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <nav class="lang-switch" aria-label="{{ t.nav.languageLabel }}">
      <ul>
        {% for link in p.languageLinks %}
        <li>
          {% if link.current %}
          <span lang="{{ link.htmlLang }}" aria-current="page">{{ link.name }}</span>
          {% else %}
          <a href="{{ link.href }}" hreflang="{{ link.htmlLang }}" lang="{{ link.htmlLang }}" data-sections="{{ link.sections }}">{{ link.name }}</a>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>
  </header>

  <main id="main">
{{ content | safe }}
  </main>

  <footer class="site-footer">
    <nav aria-label="{{ t.footer.socialLabel }}">
      <ul>
        {% for link in p.social %}
        <li><a href="{{ link.url }}">{{ link.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    {% if p.reviewUrl %}
    <p class="review"><strong>{{ t.review.title }}</strong> <a href="{{ p.reviewUrl }}">{{ t.review.text }}</a></p>
    {% endif %}
  </footer>
</body>
</html>
