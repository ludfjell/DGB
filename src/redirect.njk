---
pagination:
  data: site.redirects
  size: 1
  alias: r
permalink: "{{ r.permalink }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="{{ r.htmlLang }}">
<head>
  <meta charset="utf-8">
  <title>{{ r.title }}</title>
  <meta http-equiv="refresh" content="0; url={{ r.target }}">
  <link rel="canonical" href="{{ r.canonical }}">
  {% if not site.launched %}
  <meta name="robots" content="noindex">
  {% endif %}
</head>
<body>
  <p><a href="{{ r.target }}">{{ r.linkText }}</a></p>
</body>
</html>
